NEXT_PUBLIC_ROBOT_IDENTITY=
NEXT_PUBLIC_ROBOT_LIVEKIT_URL=
NEXT_PUBLIC_ROBOT_LIVEKIT_TOKEN=
NEXT_PUBLIC_ROVER_IDENTITY=
NEXT_PUBLIC_ROVER_LIVEKIT_URL=
NEXT_PUBLIC_ROVER_LIVEKIT_TOKEN=
# Development workspace: match the simulator's .env.local settings.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM_NAME=


# Customer trial API (server only; local supervisor or deployed Modal service).
SIM_SUPERVISOR_URL=
SIM_SUPERVISOR_KEY=
# Set to 1 on the public Vercel deployment to disable direct-room credentials.
TELEOP_PUBLIC_DEPLOYMENT=0

# 1: simulation robots open the managed page with one control queue per robot.
# 0: the robot stack handles control.  A public deployment needs 1.
PROVIDE_CONTROL_QUEUE=0

# Hey ROS voice assistant (agents/hey_ros). On by default for the direct workspace; always off
# when TELEOP_PUBLIC_DEPLOYMENT=1. Set to 0 to hide the microphone.
HEY_ROS_ENABLED=1
# Must match the agent worker's HEY_ROS_AGENT_NAME.
HEY_ROS_AGENT_NAME=hey-ros
# Voice sessions one caller may start per minute.
HEY_ROS_STARTS_PER_MINUTE=6

{
  "schema_version": 1,
  "label": "Rover with camera head",
  "exclude_data_tracks": [],
  "exclude_video_tracks": [],
  "exclude_audio_tracks": [],
  "default_video_rate_hz": 30,
  "control": {
    "scope": "robot",
    "ownership": "portal_active_operator"
  },
  "control_interfaces": {
    "base": {
      "label": "Rover",
      "kind": "mobile_base",
      "frame_id": "base_link",
      "operations": {
        "drive": {
          "profile": "base.twist.v1",
          "command": {
            "track_name": "/cmd_vel",
            "msg_type": "geometry_msgs/msg/Twist",
            "format": "json"
          },
          "presentations": [
            "gamepad",
            "joystick",
            "keyboard"
          ]
        }
      }
    },
    "head": {
      "label": "Camera head",
      "kind": "pan_tilt",
      "frame_id": "head_base_link",
      "joint_names": [
        "pan_joint",
        "tilt_joint"
      ],
      "operations": {
        "joint_velocity": {
          "profile": "joints.velocity_jog.v1",
          "command": {
            "track_name": "/head/joint_jog",
            "msg_type": "control_msgs/msg/JointJog",
            "format": "json"
          },
          "presentations": [
            "gamepad",
            "joint_sliders"
          ]
        }
      }
    }
  }
}
